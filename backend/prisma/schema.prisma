datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
  id           String    @id @map("user_id") @db.Uuid
  name         String
  email        String    @unique
  phone        String?
  region       String?
  created_at   DateTime  @default(now()) @map("created_at")
  updated_at   DateTime  @updatedAt @map("updated_at")

  properties   Property[]

  @@map("users")
}

model Property {
  id            String    @id @default(uuid()) @map("property_id") @db.Uuid
  user_id       String    @map("user_id") @db.Uuid
  name          String
  h3_token                       String   @db.VarChar(15)
  latitude                       Float?
  longitude                      Float?
  created_at    DateTime  @default(now()) @map("created_at")
  updated_at    DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  crops         Crop[]

  @@unique([user_id, name])
  @@map("properties")
}

model Crop {
  id                        String    @id @default(uuid()) @map("crop_id") @db.Uuid
  property_id               String    @map("property_id") @db.Uuid
  name                      String
  crop_type                 String    @map("crop_type")
  irrigation_system_type    String    @map("irrigation_system_type")
  irrigation_turn           Int               @map("irrigation_turn")
  planting_date             DateTime  @map("planting_date") @db.Date
  area_planted_hectares     Float?    @map("area_planted_hectares")
  created_at                DateTime  @default(now()) @map("created_at")
  updated_at                DateTime  @updatedAt @map("updated_at")

  property                  Property                @relation(fields: [property_id], references: [id], onDelete: Cascade)
  irrigation_calculations   Calculation[]

  @@unique([property_id, name])
  @@map("crops")
}

model ClimateData {
  id                             String   @id @default(uuid()) @map("climate_data_id") @db.Uuid
  h3_token                       String   @db.VarChar(15)
  reference_month                Int      @map("reference_month")
  reference_year                 Int      @map("reference_year")
  latitude                       Float?
  longitude                      Float?
  eto_mm                         Float    @map("eto_mm")
  temperature_min_annual         Float?   @map("temperature_min_annual")
  temperature_max_annual         Float?   @map("temperature_max_annual")
  temperature_avg_annual         Float?   @map("temperature_avg_annual")
  rainfall_annual_mm             Float?   @map("rainfall_annual_mm")
  rainfall_monthly               Json     @map("rainfall_monthly")
  humidity_avg                   Float?   @map("humidity_avg")
  humidity_monthly               Json     @map("humidity_monthly")
  wind_speed_avg                 Float?   @map("wind_speed_avg")
  solar_radiation_avg            Float?   @map("solar_radiation_avg")
  koppen_climate_classification  String?  @map("koppen_climate_classification")
  source                         String
  source_url                     String?  @map("source_url")
  last_fetched_at                DateTime @map("last_fetched_at")
  data_year_range                String?  @map("data_year_range")
  created_at                     DateTime @default(now()) @map("created_at")
  updated_at                     DateTime @updatedAt @map("updated_at")

  irrigation_calculations        Calculation[]

  @@unique([s2_token, reference_month, reference_year])
  @@index([s2_token])
  @@map("climate_data")
}

model Calculation {
  id                        String            @id @default(uuid()) @map("calculation_id") @db.Uuid
  h3_token                  String            @db.VarChar(15)
  calculated_at             DateTime          @default(now()) @map("calculated_at")
  etcrop_mm                 Float             @map("etcrop_mm")
  irrigation_turn           Int               @map("irrigation_turn")
  lamina_liquida_mm         Float             @map("lamina_liquida_mm")
  lamina_bruta_mm           Float             @map("lamina_bruta_mm")
  tempo_irrigacao_hours     Float             @map("tempo_irrigacao_hours")
  volume_total_liters       Float             @map("volume_total_liters")

  climate_data_id            String   @map("climate_data_id") @db.Uuid
  climate_data                ClimateData @relation(fields: [climate_data_id], references: [id], onDelete: Restrict)

  crop_id                    String?  @map("crop_id") @db.Uuid
  crop                       Crop?    @relation(fields: [crop_id], references: [id], onDelete: SetNull)

  @@index([crop_id, calculated_at(sort: Desc)])
  @@index([h3_token, calculated_at(sort: Desc)])
  @@index([climate_data_id])
  @@map("irrigation_calculations")
}